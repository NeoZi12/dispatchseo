# DispatchSEO - environment variables.
# Copy to .env.local for local dev; set the same keys in Vercel for production.

# --- Supabase (create a free project at supabase.com, then apply supabase/migrations/) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# The Vercel Marketplace Supabase integration injects this as SUPABASE_SECRET_KEY
# instead - both names work (db.ts checks SUPABASE_SERVICE_ROLE_KEY first).

# --- MCP + cron auth (OPTIONAL overrides - the setup wizard replaces these) ---
# Fresh deploys generate both at /setup and store them in the database; most
# installs leave these empty. Setting one (e.g. `openssl rand -hex 24`)
# overrides the stored value - that's how pre-wizard installs keep working.
MCP_API_KEY=
CRON_SECRET=

# --- Backend URL (OPTIONAL override - normally auto-derived) ---
# Self-hosted deploys don't need this: the wizard captures this deploy's own
# URL at claim time and every connected repo's pipeline uses that automatically
# (falling back to Vercel's own VERCEL_PROJECT_PRODUCTION_URL if claimed before
# that column existed). Set APP_URL only to force a specific domain - e.g. you
# front the deploy with a custom domain the claim request never saw.
APP_URL=

# --- DataForSEO (optional - keyword volumes + SERP rank tracking) ---
# LOGIN is your account email; PASSWORD is the auto-generated API password from
# app.dataforseo.com/api-access (NOT your dashboard login password). Leave empty
# to run without paid SERP data; paid features skip gracefully.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Encrypts per-project DataForSEO API passwords at rest (AES-256-GCM). Generate
# with `openssl rand -base64 32`. Use the SAME value in local dev and Vercel;
# rotating it makes already-stored passwords undecryptable. Not needed in the
# GitHub Actions pipeline (those workflows use their own DATAFORSEO_* secrets).
# OPTIONAL since migration 0027: claimed instances auto-generate a key into
# instance_settings.enc_key, and env only overrides it. CAUTION: setting this
# AFTER credentials were saved under the auto-generated key makes them
# undecryptable (shows as "not connected") - reconnect the credentials on the
# dashboard after switching keys.
DATAFORSEO_ENC_KEY=

# --- Google Search Console (free - impressions/clicks/position stats) ---
# The full service-account JSON key, single line. Add the service account's
# email as a user on your Search Console property.
GSC_SERVICE_ACCOUNT_JSON=
# Your property, e.g. sc-domain:example.com (domain property) or https://example.com/ (URL prefix)
GSC_SITE_URL=

# --- Weekly opportunities cron seeds (comma-separated topics around your product) ---
SEED_KEYWORDS=your topic,another topic,a third topic

# --- Dashboard login (OPTIONAL override - the setup wizard replaces it) ---
# Fresh deploys choose the password at /setup (stored as a hash in the DB).
# Setting this env var overrides the stored one; it is how pre-wizard
# installs keep working. If you set it, make it strong - it is the only gate.
DASHBOARD_PASSWORD=

# --- Google OAuth "Connect Search Console" button (optional - cloud/demo) ---
# Self-hosters don't need these; the service-account path above is the normal
# route. Create an OAuth client (Web application) in Google Cloud Console with
# redirect URI https://<your-domain>/api/oauth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 1 = the new setup's Google step also asks to verify the site and add it to
# Search Console (webmasters + siteverification). Leave unset until Google approves those scopes.
GOOGLE_SETUP_SCOPES=
# Signing key for the OAuth CSRF state (any long random string). Cloud deploys
# set this so DASHBOARD_PASSWORD can be removed entirely; self-hosters can
# leave it empty - the dashboard password doubles as the key.
OAUTH_STATE_SECRET=

# --- One-tap PR merge (optional - buttons degrade to links without it) ---
# A GitHub personal access token (repo scope) that lets the dashboard's merge
# and re-run-validation buttons act directly instead of only linking out to
# the PR/Action on GitHub. Without it those buttons still show; they just open
# the GitHub page for you to click through instead of firing in one tap.
GH_MERGE_TOKEN=
# CLOUD_MODE only: which projects (comma-separated project IDS - the uuid in
# the projects table) may use GH_MERGE_TOKEN at all. Tenants authenticate
# through their own GitHub App installation; the instance token is reserved
# for the operator's own sites that predate the App. Unset = no project may
# use it on cloud. Self-host ignores this. Slugs are still read for now, but a
# slug can be reused by another tenant after a delete - list ids. Once any id
# is listed, a project is matched by its id only.
GH_MERGE_TOKEN_PROJECTS=

# --- Cron failure emails (strongly recommended in auto mode - without them,
# failures only surface when you open the dashboard) ---
# Free key from resend.com. ALERT_EMAIL is where failure emails go (max one
# per job per 24h). Leave ALERT_EMAIL_FROM empty to use Resend's test sender;
# set it once you verify your own domain in Resend.
RESEND_API_KEY=
ALERT_EMAIL=
ALERT_EMAIL_FROM=
# CLOUD_MODE only. Verified Resend sender for customer-facing emails (the free
# plan's inactivity warning). Without it those emails are not sent.
# CUSTOMER_EMAIL_FROM="DispatchSEO <hello@your-domain.com>"

# Cloud only: the owner's own inbox gets one email each time a site launches
# on the free plan, with how many people are on it. Separate from ALERT_EMAIL
# so good news can be on while failure emails stay off.
SIGNUP_ALERT_EMAIL=

# --- PostHog (optional - product analytics, session replay, error tracking) ---
# Project API token from your PostHog project settings. Self-hosters can point
# this at their own PostHog project or leave it empty to run with none - both
# the client and server instrumentation no-op without a token.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# https://us.i.posthog.com for US Cloud, https://eu.i.posthog.com for EU Cloud.
NEXT_PUBLIC_POSTHOG_HOST=

# --- Sentry (optional - error tracking + performance) ---
# The DSN from your Sentry project's Settings -> Client Keys (DSN). Leave it
# empty and nothing is ever sent anywhere: the client, server and edge SDKs
# each skip init entirely and next.config.ts skips the build plugin. (The SDK
# itself is still bundled - ~65KB gzipped of code that never runs - because the
# import is static so early errors are catchable.) Not a secret: a DSN ships in
# the browser bundle by design and only says where events go.
NEXT_PUBLIC_SENTRY_DSN=
# OPTIONAL. Set only to send server/edge errors to a DIFFERENT Sentry project
# than the browser; unset, both use NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
# Source-map upload, so production stack traces name your files and lines
# instead of chunk-4f2a.js:1:38210. All three are build-time only. The token is
# an org auth token from Sentry Settings -> Auth Tokens with the
# project:releases scope - this one IS a secret. Omit them and errors still
# arrive; the traces are just minified.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Public landing page (cloud deployment only - leave unset when self-hosting) ---
# "true" serves the marketing landing page + cloud waitlist at /. Self-hosted
# installs leave this unset so / goes straight to the dashboard login.
LANDING_ENABLED=

# --- Cloud mode (the hosted dispatchseo.com deployment only) ---
# "true" switches the dashboard from the single self-host password to real
# multi-user accounts: Supabase Auth sign-in, per-user project ownership
# (migration 0031), billing. Self-hosters leave BOTH unset. SUPABASE_ANON_KEY
# is the same project's anon/publishable key (Supabase dashboard -> API keys);
# auth sessions run through it, while server code keeps using the service key.
CLOUD_MODE=
SUPABASE_ANON_KEY=
# Polar billing (cloud only). Access token from polar.sh Settings -> API;
# webhook secret from the webhook endpoint you create there (point it at
# https://<domain>/api/polar/webhook, event: customer.state_changed).
# The product ids come from the Polar products you create (monthly, and
# optionally yearly, per tier).
# POLAR_SERVER=sandbox switches to Polar's test environment.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_GROWTH=
POLAR_PRODUCT_SCALE=
# Optional: the yearly products (one per tier, priced at 12 x the "annual"
# column of TIER_LIMITS in src/lib/billing.ts). Set all three and the pricing
# surfaces offer a monthly/yearly choice; leave them unset and only the monthly
# plans are sold.
POLAR_PRODUCT_STARTER_ANNUAL=
POLAR_PRODUCT_GROWTH_ANNUAL=
POLAR_PRODUCT_SCALE_ANNUAL=
# GitHub App (cloud only - the one-click "Connect GitHub" install flow). Create
# a GitHub App, then copy these from its settings page. SLUG is the App's URL
# name (github.com/apps/<slug>) - if it is unset the install link 404s.
# PRIVATE_KEY is the full PEM, newlines and all (paste it whole; the code
# tolerates Vercel's \n-escaping). Point the App's webhook at
# https://<domain>/api/github/webhook and put its secret in WEBHOOK_SECRET.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# Bundled DataForSEO (cloud only). One platform account bills every paid project
# that never connected its own DataForSEO creds; per-tier budgets (migration
# 0035) cap the spend. Same kind of value as DATAFORSEO_LOGIN/PASSWORD above,
# but the platform-wide account. Leave unset when self-hosting.
DATAFORSEO_PLATFORM_LOGIN=
DATAFORSEO_PLATFORM_PASSWORD=

# GitHub App user-authorization (CLOUD only, required alongside GITHUB_APP_ID /
# GITHUB_APP_PRIVATE_KEY / GITHUB_APP_WEBHOOK_SECRET). The App must also have
# "Request user authorization (OAuth) during installation" enabled, with its
# Callback URL set to <origin>/api/github/install/callback.
#
# These prove the person who clicked Install actually controls the installation
# being claimed: the callback exchanges GitHub's one-time ?code= for that user's
# token and checks the installation appears in their own /user/installations.
# Without them the claim falls back to a freshness heuristic - see
# callerControlsInstallation in src/lib/github-app.ts. The deploy check alarms
# in CLOUD_MODE if they are missing.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Install proof is REQUIRED by default whenever the client id/secret above are
# set: a callback with no ?code is refused, and a ?code that fails verification
# is always refused. The App must have "Request user authorization (OAuth)
# during installation" enabled or GitHub sends no code. Set to 0 to fall back
# to the freshness / suspension gate for a callback with no code.
GITHUB_APP_REQUIRE_INSTALL_PROOF=

# --- Hosted writer (src/lib/writer/, pivot of 2026-10-22) ---------------------
# Our server writes the articles. Decisions (fact relevance, claim support,
# plan and article rubrics) go to TypeSafe's Jev; generation to Claude.
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
# 1 = run the whole pipeline with canned answers and no vendor calls.
WRITER_DRY_RUN=
# CLOUD_MODE only: Supabase auth user ids (comma-separated) of the operators.
# They get the "All sites" strip on a hosted Home (every hosted site's
# critical issues) and the /owner page (traffic, funnel, every customer's
# revenue and cost). Unset = nobody. Operator emails stay off by design;
# these are the operator's surfaces.
OPERATOR_USER_IDS=
# CLOUD_MODE only, required for the free plan: the key for the free plan's
# abuse-ledger hashes (lib/free-gate.ts). A long random string
# (openssl rand -hex 32). Set it once and never change it - a new value forgets
# every free claim. Unset = the free plan refuses every launch.
# FREE_GATE_SALT=
# Optional. Salts the daily visitor hash in the first-party visit log
# (lib/visits.ts); blank falls back to CRON_SECRET, and with neither set no
# visits are recorded at all. Set VISITS_RECORD=1 to record
# visits from a local `next dev` (off by default so your own page loads never
# land in the live count).
VISITOR_SALT=
VISITS_RECORD=
# Optional. A Polar organization token with ONLY the orders:read scope, for
# /owner's real payments (charged, tax, Polar fee, refunds). Kept apart from
# POLAR_ACCESS_TOKEN so the token checkout runs on never needs widening.
POLAR_READ_TOKEN=
# One-time PostHog history import (scripts/import-posthog.mjs), local only -
# the deployed app never reads these. A personal API key with the
# "query:read" scope, and the numeric project id (PostHog > Settings > Project).
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Spend guards on top of the plan cadence: runs in flight per site, and runs
# started per site per UTC day (defaults 2 and 3).
WRITER_MAX_RUNNING=
WRITER_DAILY_START_CAP=
# Model spend one article run may reach before its idea is parked (USD,
# default 0.60; a finished article costs ~0.25) - the "something is looping"
# line - and the usable facts research must find before the planner and the
# writer are paid for (default 10).
WRITER_RUN_MAX_USD=
WRITER_MIN_FACTS=
# Research-v2 (2026-11-10): the cheaper keyword-research ladder - the model
# proposes ~150 searches measured by ONE keyword_overview task, then ONE
# keyword_ideas task for every seed instead of a keyword_suggestions task per
# seed; per-seed tasks on 3 seeds stay as the backup. Same filter, same judge,
# every queued idea still has a measured volume and KD. "free" = free-plan
# sites only, "all" = every hosted site, unset = the v1 ladder. Measure with
# POST /api/cron/research-shadow?slug=<site>&v2=1 (writes nothing) first.
RESEARCH_V2=
# Daily model-spend ceilings, summed from the day's writer runs (UTC): no new
# article starts for a site past WRITER_PROJECT_DAILY_USD (default 2) or on
# the deploy past WRITER_PLATFORM_DAILY_USD (default 40). The last belt
# behind the per-run cap and the start caps above.
WRITER_PROJECT_DAILY_USD=
WRITER_PLATFORM_DAILY_USD=
# Optional: screenshots of live articles for their detail-page preview, via
# Cloudflare Browser Rendering (token needs "Browser Rendering - Edit", shown
# as "Browser Run - Edit" in newer dashboards). Shot once per page and kept in
# page_screenshots (0071). Unset (or failing) = Microlink's screenshot API:
# keyless on its small free tier, MICROLINK_API_KEY for the paid one. Both
# down = a plain title card.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BROWSER_TOKEN=
MICROLINK_API_KEY=
# The autopilot's cadence: articles per week per plan tier (defaults 1, 2, 3;
# a trial counts as Starter, self-host and unbilled projects get 2). Never
# more than one article every two days per site, whatever these say.
# The autopilot's cadence: articles per week per plan tier (defaults 1, 3, 5;
# a trial counts as Starter, self-host and unbilled projects get 2). Up to
# three a week start two days apart; five is one a day.
WRITER_WEEKLY_STARTER=
WRITER_WEEKLY_GROWTH=
WRITER_WEEKLY_SCALE=
# Slot routing for a bake-off (haiku | sonnet | opus): writer defaults to
# opus, planner to sonnet, extractor to haiku.
# WRITER_WRITER=opus  WRITER_PLANNER=sonnet  WRITER_EXTRACTOR=haiku
# Model ids and per-million prices (feed the model_calls ledger):
# WRITER_OPUS_MODEL=claude-opus-5-5 WRITER_OPUS_INPUT_PER_M=4 WRITER_OPUS_OUTPUT_PER_M=20
# WRITER_SONNET_MODEL=claude-sonnet-5-5 WRITER_SONNET_INPUT_PER_M=2 WRITER_SONNET_OUTPUT_PER_M=10
# WRITER_HAIKU_MODEL=claude-haiku-5-5 WRITER_HAIKU_INPUT_PER_M=0.1 WRITER_HAIKU_OUTPUT_PER_M=0.5
# WRITER_JEV_MODEL=jev-latest WRITER_JEV_INPUT_PER_M=0.042 TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
